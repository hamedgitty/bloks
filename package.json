{
  "name": "bloks",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first desktop workspace for personal AI agents.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Bloks contributors",
  "homepage": "https://github.com/hamedgitty/bloks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamedgitty/bloks.git"
  },
  "bugs": {
    "url": "https://github.com/hamedgitty/bloks/issues"
  },
  "keywords": [
    "ai-agents",
    "local-first",
    "desktop",
    "electron",
    "claude-code",
    "codex",
    "gemini-cli",
    "agent-client-protocol"
  ],
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.ts",
    "dev:desktop": "node scripts/bundle-updater.mjs && electron .",
    "build": "node scripts/bundle-updater.mjs && tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json && tsc -p tsconfig.test.json",
    "test": "node --test \"test/*.test.ts\"",
    "test:watch": "node --test --watch \"test/*.test.ts\"",
    "preview": "vite preview",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build:helpers": "bash scripts/build-helpers.sh",
    "build:icon": "node scripts/render-icon.mjs",
    "package:prep": "pnpm build && pnpm build:server && pnpm build:helpers",
    "package": "pnpm package:prep && electron-builder --mac --publish never",
    "release": "pnpm package:prep && electron-builder --mac --publish always",
    "package:prep:xplat": "pnpm build && pnpm build:server",
    "package:linux": "pnpm package:prep:xplat && electron-builder --linux --publish never",
    "package:win": "pnpm package:prep:xplat && electron-builder --win --publish never",
    "bundle:updater": "node scripts/bundle-updater.mjs",
    "screenshots": "node scripts/shoot-screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@trycua/cua-driver": "^0.19.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.539.0",
    "posthog-js": "^1.415.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
