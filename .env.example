# Bloks on a server of your own: every setting compose.yml reads.
# Copy this to .env, fill in what you use, and leave the rest commented
# out. docs/DOCKER.md says more about each.

# ── Where your devices reach it ────────────────────────────────────────

# The address your desktop app and phone use to reach this server. An
# https one behind your reverse proxy or tunnel, or an http one on your
# VPN or home network, port and all. Pairing hands a device this address,
# and the device talks to it directly from then on. Commas for more than
# one (a public name and a Tailscale address, say).
BLOKS_PUBLIC_URL=https://bloks.example.com
# BLOKS_PUBLIC_URL=http://100.101.102.103:8799

# Which host address the port is published on. 127.0.0.1 (the default)
# for a reverse proxy or tunnel on this machine; your Tailscale address
# for the tailnet alone; 0.0.0.0 for every interface.
# BLOKS_BIND=127.0.0.1

# The port on the host. Inside the container it is always 8799.
# BLOKS_HOST_PORT=8799

# ── Bloks Cloud ────────────────────────────────────────────────────────

# off (the default here): nothing is sent to Bloks Cloud or bloks.dev.
# on: a licence key can also make it reachable through Bloks Cloud
# (docker compose exec bloks bloks-server activate blok_live_...).
# BLOKS_CLOUD=off

# ── The server ─────────────────────────────────────────────────────────

# What your devices call this server. Defaults to bloks.
# BLOKS_COMPUTER_NAME=homelab

# 1: your own paired devices may open a terminal on this server (to
# install and sign in to engines, say). Never a member's device or an
# agent. Off unless set.
# BLOKS_OWNER_TERMINAL=1

# The image tag: latest, or a version such as 3.2.1 to stay on it.
# BLOKS_VERSION=latest

# Where everything Bloks keeps lives: the named volume bloks-home by
# default, or a host folder owned by uid 1000.
# BLOKS_DATA=./data

# TZ=Europe/London

# ── Your own model server (OpenAI-compatible) ─────────────────────────

# vLLM, llama.cpp's server, LM Studio, LiteLLM or anything else that
# speaks /v1/chat/completions: a self-hosted Qwen, say. Its /v1 root; a
# server on this machine outside compose is host.docker.internal.
# BLOKS_MODEL_URL=http://host.docker.internal:8000/v1
# Its key, if it asks for one.
# BLOKS_MODEL_KEY=
# What the engine is called in the app.
# BLOKS_MODEL_NAME=Qwen
# 1 if its model calls tools (Qwen does, with vLLM's tool parser on), so
# agents can use Bloks tools there. Chat only until you say so.
# BLOKS_MODEL_TOOLS=1
# 1 if its model sees pictures.
# BLOKS_MODEL_VISION=1

# Ollama is found on its own once it answers here.
# OLLAMA_HOST=http://host.docker.internal:11434

# ── Claude Code on an Anthropic-compatible server ─────────────────────

# Read by Claude Code itself, once it is installed in the container: a
# gateway or proxy that speaks Anthropic's API (LiteLLM, for one) in
# place of Anthropic. Set all three or none.
# ANTHROPIC_BASE_URL=http://host.docker.internal:4000
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=qwen3-coder

# ── Hosted providers ───────────────────────────────────────────────────

# A key connects its provider, with nothing to do in Settings.
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=

# ── Signing in from a browser (the web door) ───────────────────────────

# A page at an address of your own that your family or team signs in to
# with your identity provider (Authentik, Keycloak, Authelia, Google).
# Off until BLOKS_WEB_URL is set. docs/SELF_HOSTING.md walks through it.
# BLOKS_WEB_URL=https://bloks.example.com
# compose.yml has it listen on every interface inside the container and
# maps 8790 on host loopback, for your proxy.
# BLOKS_OIDC_ISSUER=https://auth.example.com/application/o/bloks/
# BLOKS_OIDC_CLIENT_ID=
# BLOKS_OIDC_CLIENT_SECRET=
# Who may come in: groups or emails, comma separated.
# BLOKS_OIDC_ALLOWED_GROUPS=family
# BLOKS_OIDC_ALLOWED_EMAILS=
# 1 to make a member of anybody allowed in, on their first sign-in.
# BLOKS_OIDC_AUTO_CREATE=1
# A group whose people are admins.
# BLOKS_OIDC_ADMIN_GROUP=bloks-admins
# Your own sign-in identity, so you come in as the owner.
# BLOKS_OIDC_OWNER=you@example.com
