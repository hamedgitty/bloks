node_modules
dist
dist-electron
*.local
.DS_Store
*.tsbuildinfo
# compiled Swift helpers: built by scripts/build-helpers.sh at package
# time, or lazily in dev. Never committed; a checked-in Mach-O goes stale
# and is the wrong architecture half the time.
electron/resources/speech-helper
electron/resources/perm-helper
release

# build output
dist-server

# Xcode. The .xcodeproj IS committed, so nobody needs xcodegen to build;
# only derived output is ignored.
xcuserdata
*.xcuserstate

# third-party skills, restored with: npx skills add (see skills-lock.json)
.agents/skills
.claude

# reference material, not product
Routines UI Example/

# Secrets that must never enter history, even by accident
*.p8
*.p12
*.mobileprovision
*.pem
.env
.env.*
**/DerivedData/
DerivedData/

# wrangler local dev state
.wrangler/

# Wrangler's own name for local secrets. Not covered by the .env rules
# above, which is exactly how a Stripe key ends up in a public repo: the
# file is called something you were not looking for.
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*

# generated by scripts/bundle-updater.mjs at build time
electron/vendor/

# Working notes: planning, drafts, anything not meant to ship.

# Not in the Xcode project, so nothing compiles them. Kept for whenever
# a watch target is real; out of the repo until it is.
